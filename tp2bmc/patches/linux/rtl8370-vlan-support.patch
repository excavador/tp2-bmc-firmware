+
+static int rtl8365mb_table_poll_busy(struct realtek_priv *priv)
+{
+        u32 val;
+
+        return regmap_read_poll_timeout(priv->map_nolock,
+                                        RTL8365MB_TABLE_STATUS_REG,
+                                        val,
+                                        !(val & RTL8365MB_TABLE_STATUS_BUSY_MASK),
+                                        10, 10000);
+}
+
+static void rtl8365mb_vlan4k_encode(const struct rtl8365mb_vlan4k *vlan,
+                                    u16 data[RTL8365MB_VLAN4K_WORDS])
+{
+        memset(data, 0, sizeof(u16) * RTL8365MB_VLAN4K_WORDS);
+
+        data[0] |= vlan->member & 0x00ff;
+        data[0] |= (vlan->untag & 0x00ff) << 8;
+
+        data[1] |= vlan->fid & 0x0f;
+        data[1] |= (vlan->priority_en ? 1 : 0) << 4;
+        data[1] |= (vlan->priority & 0x07) << 5;
+        data[1] |= (vlan->policing_en ? 1 : 0) << 8;
+        data[1] |= (vlan->meter & 0x1f) << 9;
+        data[1] |= (vlan->ivl ? 1 : 0) << 14;
+
+        data[2] |= (vlan->member >> 8) & 0x07;
+        data[2] |= ((vlan->untag >> 8) & 0x07) << 3;
+        data[2] |= ((vlan->meter >> 5) & 0x01) << 6;
+}
+
+static void rtl8365mb_vlan4k_decode(const u16 data[RTL8365MB_VLAN4K_WORDS],
+                                    struct rtl8365mb_vlan4k *vlan)
+{
+        vlan->member = (data[0] & 0x00ff) |
+                       ((data[2] & 0x0007) << 8);
+
+        vlan->untag = ((data[0] >> 8) & 0x00ff) |
+                      (((data[2] >> 3) & 0x0007) << 8);
+
+        vlan->fid = data[1] & 0x0f;
+        vlan->priority_en = !!(data[1] & BIT(4));
+        vlan->priority = (data[1] >> 5) & 0x07;
+        vlan->policing_en = !!(data[1] & BIT(8));
+        vlan->meter = ((data[1] >> 9) & 0x1f) |
+                      (((data[2] >> 6) & 0x01) << 5);
+        vlan->ivl = !!(data[1] & BIT(14));
+}
+
+static int rtl8365mb_vlan4k_read(struct realtek_priv *priv,
+                                 u16 vid,
+                                 struct rtl8365mb_vlan4k *vlan)
+{
+        u16 data[RTL8365MB_VLAN4K_WORDS];
+        u32 val;
+        int ret;
+        int i;
+
+        if (vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        mutex_lock(&priv->map_lock);
+
+        ret = rtl8365mb_table_poll_busy(priv);
+        if (ret)
+                goto out;
+
+        ret = regmap_write(priv->map_nolock,
+                           RTL8365MB_TABLE_ACCESS_ADDR_REG, vid);
+        if (ret)
+                goto out;
+
+        val = FIELD_PREP(RTL8365MB_TABLE_CTRL_TABLE_MASK,
+                         RTL8365MB_TABLE_CVLAN) |
+              FIELD_PREP(RTL8365MB_TABLE_CTRL_OP_MASK,
+                         RTL8365MB_TABLE_OP_READ);
+
+        ret = regmap_write(priv->map_nolock,
+                           RTL8365MB_TABLE_CTRL_REG, val);
+        if (ret)
+                goto out;
+
+        ret = rtl8365mb_table_poll_busy(priv);
+        if (ret)
+                goto out;
+
+        for (i = 0; i < RTL8365MB_VLAN4K_WORDS; i++) {
+                ret = regmap_read(priv->map_nolock,
+                                  RTL8365MB_TABLE_READ_REG(i), &val);
+                if (ret)
+                        goto out;
+
+                data[i] = val;
+        }
+
+        memset(vlan, 0, sizeof(*vlan));
+        vlan->vid = vid;
+        rtl8365mb_vlan4k_decode(data, vlan);
+
+out:
+        mutex_unlock(&priv->map_lock);
+        return ret;
+}
+
+static int rtl8365mb_vlan4k_write(struct realtek_priv *priv,
+                                  const struct rtl8365mb_vlan4k *vlan)
+{
+        u16 data[RTL8365MB_VLAN4K_WORDS];
+        u32 val;
+        int ret;
+        int i;
+
+        if (vlan->vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        rtl8365mb_vlan4k_encode(vlan, data);
+
+        mutex_lock(&priv->map_lock);
+
+        ret = rtl8365mb_table_poll_busy(priv);
+        if (ret)
+                goto out;
+
+        for (i = 0; i < RTL8365MB_VLAN4K_WORDS; i++) {
+                ret = regmap_write(priv->map_nolock,
+                                   RTL8365MB_TABLE_WRITE_REG(i),
+                                   data[i]);
+                if (ret)
+                        goto out;
+        }
+
+        ret = regmap_write(priv->map_nolock,
+                           RTL8365MB_TABLE_ACCESS_ADDR_REG,
+                           vlan->vid);
+        if (ret)
+                goto out;
+
+        val = FIELD_PREP(RTL8365MB_TABLE_CTRL_TABLE_MASK,
+                         RTL8365MB_TABLE_CVLAN) |
+              FIELD_PREP(RTL8365MB_TABLE_CTRL_OP_MASK,
+                         RTL8365MB_TABLE_OP_WRITE);
+
+        ret = regmap_write(priv->map_nolock,
+                           RTL8365MB_TABLE_CTRL_REG, val);
+
+out:
+        mutex_unlock(&priv->map_lock);
+        return ret;
+}
+
+static int rtl8365mb_vlan_mc_read(struct realtek_priv *priv, int index,
+                                  struct rtl8365mb_vlan_mc *vlan)
+{
+        u32 data[RTL8365MB_VLAN_MC_WORDS];
+        int ret;
+        int i;
+
+        if (index < 0 || index >= RTL8365MB_VLAN_MC_NUM)
+                return -EINVAL;
+
+        for (i = 0; i < RTL8365MB_VLAN_MC_WORDS; i++) {
+                ret = regmap_read(priv->map,
+                                  RTL8365MB_VLAN_MC_REG(index, i),
+                                  &data[i]);
+                if (ret)
+                        return ret;
+        }
+
+        memset(vlan, 0, sizeof(*vlan));
+
+        vlan->member = data[0] & 0x07ff;
+        vlan->fid = data[1] & 0x000f;
+
+        vlan->priority_en = (data[2] & BIT(0)) != 0;
+        vlan->priority = (data[2] >> 1) & 0x07;
+        vlan->policing_en = (data[2] & BIT(4)) != 0;
+        vlan->meter = (data[2] >> 5) & 0x3f;
+
+        vlan->evid = data[3] & 0x1fff;
+
+        return 0;
+}
+
+static int rtl8365mb_vlan_mc_write(struct realtek_priv *priv, int index,
+                                   const struct rtl8365mb_vlan_mc *vlan)
+{
+        u16 data[RTL8365MB_VLAN_MC_WORDS] = {};
+        int ret;
+        int i;
+
+        if (index < 0 || index >= RTL8365MB_VLAN_MC_NUM)
+                return -EINVAL;
+
+        data[0] = vlan->member & 0x07ff;
+
+        data[1] = vlan->fid & 0x000f;
+
+        data[2] = vlan->priority_en ? BIT(0) : 0;
+        data[2] |= (vlan->priority & 0x07) << 1;
+        data[2] |= vlan->policing_en ? BIT(4) : 0;
+        data[2] |= (vlan->meter & 0x3f) << 5;
+
+        data[3] = vlan->evid & 0x1fff;
+
+        for (i = 0; i < RTL8365MB_VLAN_MC_WORDS; i++) {
+                ret = regmap_write(priv->map,
+                                   RTL8365MB_VLAN_MC_REG(index, i),
+                                   data[i]);
+                if (ret)
+                        return ret;
+        }
+
+        return 0;
+}
+
+static int rtl8365mb_vlan_mc_find(struct realtek_priv *priv, u16 vid,
+                                  u8 *index)
+{
+        struct rtl8365mb_vlan_mc vlanmc;
+        int ret;
+        int i;
+
+        if (vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        for (i = 0; i < RTL8365MB_VLAN_MC_NUM; i++) {
+                ret = rtl8365mb_vlan_mc_read(priv, i, &vlanmc);
+                if (ret)
+                        return ret;
+
+                if (vlanmc.evid == vid &&
+                    (vid != 0 || vlanmc.member != 0)) {
+                        *index = i;
+                        return 0;
+                }
+        }
+
+        return -ENOENT;
+}
+
+
+static int rtl8365mb_vlan_mc_obtain(struct realtek_priv *priv, u16 vid,
+                                    u8 *index)
+{
+        struct rtl8365mb_vlan4k vlan4k;
+        struct rtl8365mb_vlan_mc vlanmc;
+        int empty = -1;
+        int ret;
+        int i;
 
+        if (vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        /*
+         * First look for an existing member configuration for this VID.
+         * At the same time remember the first empty entry.
+         *
+         * The RTL8367C vendor driver defines an empty member configuration
+         * as EVID == 0 and member mask == 0.
+         */
+        for (i = 0; i < RTL8365MB_VLAN_MC_NUM; i++) {
+                ret = rtl8365mb_vlan_mc_read(priv, i, &vlanmc);
+                if (ret)
+                        return ret;
+
+                if (vlanmc.evid == vid &&
+                    (vid != 0 || vlanmc.member != 0)) {
+                        *index = i;
+                        return 0;
+                }
+
+                if (empty < 0 &&
+                    vlanmc.evid == 0 &&
+                    vlanmc.member == 0)
+                        empty = i;
+        }
+
+        if (empty < 0) {
+                dev_err(priv->dev,
+                        "all VLAN member configurations are in use\n");
+                return -ENOSPC;
+        }
+
+        /*
+         * Initialise the member configuration from the corresponding
+         * 4K VLAN entry, matching the RTL8367C vendor implementation.
+         */
+        ret = rtl8365mb_vlan4k_read(priv, vid, &vlan4k);
+        if (ret)
+                return ret;
+
+        memset(&vlanmc, 0, sizeof(vlanmc));
+
+        vlanmc.evid = vid;
+        vlanmc.member = vlan4k.member;
+        vlanmc.fid = vlan4k.fid;
+        vlanmc.priority = vlan4k.priority;
+        vlanmc.priority_en = vlan4k.priority_en;
+        vlanmc.policing_en = vlan4k.policing_en;
+        vlanmc.meter = vlan4k.meter;
+
+        ret = rtl8365mb_vlan_mc_write(priv, empty, &vlanmc);
+        if (ret)
+                return ret;
+
+        dev_dbg(priv->dev,
+                "created VLAN MC index %d for VID %u\n",
+                empty, vid);
+
+        *index = empty;
+
+        return 0;
+}
+
+
+static int rtl8365mb_port_pvid_get(struct realtek_priv *priv, int port,
+                                   u8 *index)
+{
+        u32 val;
+        int ret;
+
+        if (port < 0 || port >= RTL8365MB_MAX_NUM_PORTS)
+                return -EINVAL;
+
+        ret = regmap_read(priv->map,
+                          RTL8365MB_VLAN_PVID_CTRL_REG(port),
+                          &val);
+        if (ret)
+                return ret;
+
+        *index = (val & RTL8365MB_VLAN_PVID_MASK(port)) >>
+                 RTL8365MB_VLAN_PVID_OFFSET(port);
+
+        return 0;
+}
+
+static int rtl8365mb_port_pvid_set(struct realtek_priv *priv, int port,
+                                   u8 index)
+{
+        if (port < 0 || port >= RTL8365MB_MAX_NUM_PORTS)
+                return -EINVAL;
+
+        if (index >= RTL8365MB_VLAN_MC_NUM)
+                return -EINVAL;
+
+        return regmap_update_bits(priv->map,
+                                  RTL8365MB_VLAN_PVID_CTRL_REG(port),
+                                  RTL8365MB_VLAN_PVID_MASK(port),
+                                  index <<
+                                  RTL8365MB_VLAN_PVID_OFFSET(port));
+}
+
