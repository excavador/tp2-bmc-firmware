 		(0x3 << RTL8365MB_MSTI_CTRL_PORT_STATE_OFFSET((_physport)))
+
+/* VLAN table access */
+#define RTL8365MB_TABLE_CTRL_REG                  0x0500
+#define   RTL8365MB_TABLE_CTRL_TABLE_MASK         GENMASK(2, 0)
+#define   RTL8365MB_TABLE_CTRL_OP_MASK            BIT(3)
+
+#define RTL8365MB_TABLE_ACCESS_ADDR_REG           0x0501
+#define   RTL8365MB_TABLE_ADDR_MASK               GENMASK(12, 0)
+
+#define RTL8365MB_TABLE_STATUS_REG                0x0502
+#define   RTL8365MB_TABLE_STATUS_BUSY_MASK        BIT(13)
+
+#define RTL8365MB_TABLE_WRITE_BASE                0x0510
+#define RTL8365MB_TABLE_WRITE_REG(_n)             \
+        (RTL8365MB_TABLE_WRITE_BASE + (_n))
+
+#define RTL8365MB_TABLE_READ_BASE                 0x0520
+#define RTL8365MB_TABLE_READ_REG(_n)              \
+        (RTL8365MB_TABLE_READ_BASE + (_n))
+
+#define RTL8365MB_TABLE_OP_READ                   0
+#define RTL8365MB_TABLE_OP_WRITE                  1
+#define RTL8365MB_TABLE_CVLAN                     3
 
+#define RTL8365MB_VLAN4K_WORDS                    3
+#define RTL8365MB_VLAN_MAX                        4095
+#define RTL8365MB_VLAN_PORT_MASK                  GENMASK(10, 0)
+
+/* VLAN member configuration table: 32 entries, 4 registers each */
+#define RTL8365MB_VLAN_MC_BASE                    0x0728
+#define RTL8365MB_VLAN_MC_NUM                     32
+#define RTL8365MB_VLAN_MC_WORDS                   4
+#define RTL8365MB_VLAN_MC_REG(_index, _word)      \
+        (RTL8365MB_VLAN_MC_BASE + ((_index) * 4) + (_word))
+
+/* Port PVID uses an index into the VLAN member configuration table */
+#define RTL8365MB_VLAN_PVID_CTRL_BASE             0x0700
+#define RTL8365MB_VLAN_PVID_CTRL_REG(_port)       \
+        (RTL8365MB_VLAN_PVID_CTRL_BASE + ((_port) >> 1))
+#define RTL8365MB_VLAN_PVID_OFFSET(_port)         \
+        (((_port) & 1) << 3)
+#define RTL8365MB_VLAN_PVID_MASK(_port)           \
+        (0x1f << RTL8365MB_VLAN_PVID_OFFSET(_port))
+
+/* Global/per-port VLAN filtering */
+#define RTL8365MB_VLAN_CTRL_REG                   0x07a8
+#define RTL8365MB_VLAN_CTRL_ENABLE                BIT(0)
+
+#define RTL8365MB_VLAN_INGRESS_REG                0x07a9
+#define RTL8365MB_VLAN_INGRESS_MASK               GENMASK(10, 0)
+
+/* Per-port egress tag mode */
+#define RTL8365MB_PORT_MISC_CFG_BASE              0x000e
+#define RTL8365MB_PORT_MISC_CFG_REG(_port)        \
+        (RTL8365MB_PORT_MISC_CFG_BASE + ((_port) << 5))
+#define RTL8365MB_VLAN_EGRESS_MODE_MASK           GENMASK(5, 4)
+
+#define RTL8365MB_VLAN_EGRESS_ORIGINAL            0
+#define RTL8365MB_VLAN_EGRESS_KEEP                1
+#define RTL8365MB_VLAN_EGRESS_PRIORITY            2
