+static int rtl8365mb_port_vlan_del(struct dsa_switch *ds, int port,
+                                   const struct switchdev_obj_port_vlan *vlan)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        struct rtl8365mb_vlan4k vlan4k;
+        struct rtl8365mb_vlan_mc vlanmc;
+        u8 pvid_index;
+        u8 mc_index;
+        int ret;
 
+        if (vlan->vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        ret = rtl8365mb_vlan4k_read(priv, vlan->vid, &vlan4k);
+        if (ret)
+                return ret;
+
+        vlan4k.member &= ~BIT(port);
+        vlan4k.untag &= ~BIT(port);
+
+        /*
+         * Keep the CPU port while at least one user port remains in
+         * the VLAN. When the last user port leaves, clear the CPU
+         * membership too so the VLAN/MC entry can become empty.
+         */
+        if ((vlan4k.member & ~mb->cpu.mask) == 0)
+                vlan4k.member = 0;
+
+        ret = rtl8365mb_vlan4k_write(priv, &vlan4k);
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_find(priv, vlan->vid, &mc_index);
+        if (ret == -ENOENT)
+                return 0;
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_read(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        vlanmc.member = vlan4k.member;
+
+        if (vlanmc.member == 0) {
+                /*
+                 * Do not leave a port pointing at an MC entry that is about
+                 * to be cleared.
+                 */
+                ret = rtl8365mb_port_pvid_get(priv, port, &pvid_index);
+                if (ret)
+                        return ret;
+
+                if (pvid_index == mc_index) {
+                        /*
+                         * Index 0 is the hardware's default VLAN member
+                         * configuration after reset. Move the port away
+                         * from the deleted entry before clearing it.
+                         */
+                        if (mc_index != 0) {
+                                ret = rtl8365mb_port_pvid_set(priv, port, 0);
+                                if (ret)
+                                        return ret;
+                        }
+                }
+
+                memset(&vlanmc, 0, sizeof(vlanmc));
+        } else {
+                vlanmc.evid = vlan->vid;
+                vlanmc.fid = vlan4k.fid;
+                vlanmc.priority = vlan4k.priority;
+                vlanmc.priority_en = vlan4k.priority_en;
+                vlanmc.policing_en = vlan4k.policing_en;
+                vlanmc.meter = vlan4k.meter;
+        }
+
+        ret = rtl8365mb_vlan_mc_write(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        dev_dbg(priv->dev,
+                "port %d: deleted VLAN %u\n",
+                port, vlan->vid);
+
+        return 0;
+}
+
+
+static int rtl8365mb_port_vlan_add(struct dsa_switch *ds, int port,
+                                   const struct switchdev_obj_port_vlan *vlan,
+                                   struct netlink_ext_ack *extack)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        struct rtl8365mb_vlan4k vlan4k;
+        struct rtl8365mb_vlan_mc vlanmc;
+        u8 mc_index;
+        int ret;
+
+        if (vlan->vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        ret = rtl8365mb_vlan4k_read(priv, vlan->vid, &vlan4k);
+        if (ret)
+                return ret;
+
+        /*
+         * The CPU port must be a member of every hardware VLAN used by
+         * a user port, otherwise switch-to-CPU traffic is filtered out.
+         */
+        vlan4k.member |= BIT(port) | mb->cpu.mask;
+
+        if (vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED)
+                vlan4k.untag |= BIT(port);
+        else
+                vlan4k.untag &= ~BIT(port);
+
+        ret = rtl8365mb_vlan4k_write(priv, &vlan4k);
+        if (ret)
+                return ret;
+
+        /*
+         * If an MC entry for this VLAN already exists, keep it in sync
+         * with the 4K VLAN table.
+         */
+        ret = rtl8365mb_vlan_mc_obtain(priv, vlan->vid, &mc_index);
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_read(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        vlanmc.evid = vlan->vid;
+        vlanmc.member = vlan4k.member;
+        vlanmc.fid = vlan4k.fid;
+        vlanmc.priority = vlan4k.priority;
+        vlanmc.priority_en = vlan4k.priority_en;
+        vlanmc.policing_en = vlan4k.policing_en;
+        vlanmc.meter = vlan4k.meter;
+
+        ret = rtl8365mb_vlan_mc_write(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        if (vlan->flags & BRIDGE_VLAN_INFO_PVID) {
+                ret = rtl8365mb_port_pvid_set(priv, port, mc_index);
+                if (ret)
+                        return ret;
+        }
+
+        dev_dbg(priv->dev,
+                "port %d: added VLAN %u%s%s\n",
+                port, vlan->vid,
+                vlan->flags & BRIDGE_VLAN_INFO_PVID ? " pvid" : "",
+                vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED ? " untagged" : "");
+
+        return 0;
+}
+
+
+static int rtl8365mb_port_vlan_filtering(struct dsa_switch *ds, int port,
+                                         bool vlan_filtering,
+                                         struct netlink_ext_ack *extack)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        u16 old_ports = mb->vlan_filtering_ports;
+        u16 new_ports;
+        int ret;
+
+        if (vlan_filtering)
+                new_ports = old_ports | BIT(port);
+        else
